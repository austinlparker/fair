# Copy to sandbox/.env and fill in. Each value is a random hex string.
# `make sandbox-init` (or `sandbox/seed.sh`) generates these for you.

# 32 bytes (64 hex chars) — used to sign tokens issued by this PDS.
PDS_JWT_SECRET=

# Anything memorable; only used as a host-side admin auth for `goat`.
PDS_ADMIN_PASSWORD=

# 32-byte k256 (secp256k1) private key, hex-encoded. The PDS uses this to
# sign DID:plc rotations during account creation.
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
